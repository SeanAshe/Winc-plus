<?xml version="1.0" encoding="utf-8"?>
<!-- Types winc can open, listed under Applications\winc.exe\SupportedTypes: winc appears in
     "Open with" > "Choose another app" for them. Nothing is written under the types themselves
     unless the optional FileTypes feature is installed, so Windows keeps their default program and
     icon and does not ask which program to use. Keep this
     list the same as ForEachFileType in installer.nsi. The types are grouped by the document
     icon they show (release/windows/icons); FileTypes is all of them.
     Registry keys ignore case; upper case gives the "JSON File" name the shell shows for a type. -->
<?define MarkdownTypes = MARKDOWN;MD;MDOWN;MKD;MKDN?>
<?define JsonTypes = GEOJSON;JSON;JSON5;JSONC;JSONL;NDJSON;WEBMANIFEST?>
<?define ConfigTypes = CFG;CONF;DESKTOP;DOCKERFILE;ENV;INF;INI;PROPERTIES;SERVICE;TOML;YAML;YML?>
<?define MarkupTypes = ASTRO;ATOM;CLS;CSPROJ;DTX;FSPROJ;HTM;HTML;KML;LTX;NUSPEC;PLIST;PROPS;RESX;RSS;STORYBOARD;STY;SVELTE;SVG;TARGETS;TEX;VBPROJ;VCXPROJ;VUE;WSDL;WXML;XAML;XCSCHEME;XHTML;XIB;XML;XSD;XSL;XSLT?>
<?define StyleTypes = CSS;LESS;SASS;SCSS;WXSS?>
<?define ScriptTypes = ASH;BASH;FISH;KSH;MK;PS1;PSD1;PSM1;SH;ZSH?>
<?define TableTypes = CSV;TAB;TSV?>
<?define TextTypes = DIFF;EPUB;LOG;PATCH;PDF;TXT?>
<?define JavascriptTypes = CJS;JS;JSX;MJS?>
<?define TypescriptTypes = CTS;MTS;TS;TSX?>
<?define PythonTypes = BZL;PY;PYI;STAR?>
<?define RustTypes = RS?>
<?define GoTypes = GO?>
<?define CTypes = C;CC;CPP;CPPM;CU;CUH;CXX;H;HH;HPP;HXX;INL;INO;IPP;IXX;TPP?>
<?define CodeTypes = BB;CLJ;CLJC;CLJS;CMAKE;CS;CSX;DART;EDN;ERL;ESCRIPT;ETS;EX;EXS;FS;FSI;FSX;GEMSPEC;GQL;GRADLE;GRAPHQL;GRAPHQLS;GROOVY;HCL;HRL;HS;HSC;JAVA;JBUILDER;JL;KT;KTS;LUA;LUAU;M;ML;MLI;MLL;MLY;MM;NIX;NOMAD;PHP;PHP3;PHP4;PHP5;PHP8;PHPS;PHTML;PL;PM;POD;PODSPEC;PROTO;PSGI;R;RAKE;RB;RBI;ROCKSPEC;RPROFILE;SC;SCALA;SQL;SWIFT;T;TF;TFTEST;TFVARS;WXS;ZIG;ZON?>
<?define IconNames = markdown;json;config;markup;style;script;table;text;javascript;typescript;python;rust;go;c;code;file?>
<?define FileTypes = $(var.MarkdownTypes);$(var.JsonTypes);$(var.ConfigTypes);$(var.MarkupTypes);$(var.StyleTypes);$(var.ScriptTypes);$(var.TableTypes);$(var.TextTypes);$(var.JavascriptTypes);$(var.TypescriptTypes);$(var.PythonTypes);$(var.RustTypes);$(var.GoTypes);$(var.CTypes);$(var.CodeTypes)?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- UUIDv5(DNS, com.deeix.winc); keep this product family stable across releases. -->
  <Product Id="*" Name="Winc" Language="1033" Version="$(var.Version)" Manufacturer="DEEIX"
           UpgradeCode="00FDC6A5-D527-59AE-B4A5-E051B25222F3">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"/>
    <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallInitialize"/>
    <Property Id="REINSTALLMODE" Value="amus"/>
    <MediaTemplate EmbedCab="yes"/>
    <Icon Id="WincIcon" SourceFile="$(var.Source)\winc.ico"/>
    <Property Id="ARPPRODUCTICON" Value="WincIcon"/>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER"/>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.Source)\license.rtf"/>
    <UIRef Id="WixUI_InstallDir"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="winc">
          <Component Id="Application" Guid="*" Win64="yes">
            <File Id="WincExe" Source="$(var.Source)\winc.exe" KeyPath="yes"/>
          </Component>
          <Component Id="TerminalHelper" Guid="*" Win64="yes">
            <File Source="$(var.Source)\winc-pty.exe" KeyPath="yes"/>
          </Component>
          <Component Id="ConptyLibrary" Guid="*" Win64="yes">
            <File Source="$(var.Source)\conpty.dll" KeyPath="yes"/>
          </Component>
          <Component Id="ConsoleHost" Guid="*" Win64="yes">
            <File Source="$(var.Source)\OpenConsole.exe" KeyPath="yes"/>
          </Component>
          <Component Id="WslWatcher" Guid="*" Win64="yes">
            <File Id="WincWatch" Source="$(var.Source)\winc-watch" KeyPath="yes"/>
          </Component>
          <Component Id="RemoteServerX64" Guid="*" Win64="yes">
            <File Id="WincServerX64" Source="$(var.Source)\winc-server-Linux-x86_64" KeyPath="yes"/>
          </Component>
          <Component Id="RemoteServerArm64" Guid="*" Win64="yes">
            <File Id="WincServerArm64" Source="$(var.Source)\winc-server-Linux-aarch64" KeyPath="yes"/>
          </Component>
          <Component Id="InstallationKind" Guid="*" Win64="yes">
            <File Source="$(var.Source)\msi\winc-installation" KeyPath="yes"/>
          </Component>
          <Component Id="FileAssociations" Guid="*" Win64="yes">
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\winc.exe" Name="FriendlyAppName" Value="Winc" Type="string" KeyPath="yes"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\winc.exe\DefaultIcon" Value="[#WincExe],0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\winc.exe\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <!-- The shell reads only the value names of SupportedTypes. An empty value means Null to
                 Windows Installer, so these hold a placeholder. The winc.<type> ProgID is not listed
                 under any type; it stays for users who chose winc as the default program while
                 earlier versions listed it, whose choice names this ProgID. -->
            <?foreach Type in $(var.FileTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\Applications\winc.exe\SupportedTypes" Name=".$(var.Type)" Value="winc" Type="string"/>
            <?endforeach?>
            <!-- Each ProgID carries its type's document icon. Explorer shows it for a type whose
                 chosen program is this ProgID; a choice made through "Open with" names winc.exe
                 instead and shows its icon. -->
            <?foreach Type in $(var.MarkdownTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_markdown]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.JsonTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_json]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.ConfigTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_config]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.MarkupTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_markup]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.StyleTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_style]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.ScriptTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_script]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.TableTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_table]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.TextTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_text]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.JavascriptTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_javascript]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.TypescriptTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_typescript]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.PythonTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_python]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.RustTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_rust]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.GoTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_go]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.CTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_c]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
            <?foreach Type in $(var.CodeTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)" Value="$(var.Type) File" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\DefaultIcon" Value="[#Icon_code]" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc.$(var.Type)\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
            <?endforeach?>
          </Component>
          <!-- Optional, on by default: lists the ProgIDs under the types. A handler listed there
               makes Windows ask once which program to use. Install with ADDLOCAL=Main to leave it
               out; an upgrade keeps the earlier choice. -->
          <Component Id="FileTypeListing" Guid="*" Win64="yes">
            <RegistryValue Root="HKLM" Key="Software\DEEIX\winc\MSI" Name="File Types" Type="integer" Value="1" KeyPath="yes"/>
            <!-- The shell reads only the value names; the data is a placeholder, as above. -->
            <?foreach Type in $(var.FileTypes)?>
            <RegistryValue Root="HKLM" Key="Software\Classes\.$(var.Type)\OpenWithProgids" Name="winc.$(var.Type)" Value="winc" Type="string"/>
            <?endforeach?>
          </Component>
          <Directory Id="ICONSFOLDER" Name="icons">
            <?foreach Icon in $(var.IconNames)?>
            <Component Id="Icon_$(var.Icon)" Guid="*" Win64="yes">
              <File Id="Icon_$(var.Icon)" Source="$(var.Source)\icons\$(var.Icon).ico" KeyPath="yes"/>
            </Component>
            <?endforeach?>
          </Directory>
          <!-- Explorer context menu: one "Open with Winc" for every file, under the * class, which
               leaves each type's default program alone, and "Open in Winc" on a folder and on the
               empty space inside one (also the desktop), where %V is that folder. Windows 11 shows
               these under "Show more options". Its own feature, off by default: install with
               ADDLOCAL=ALL to add it, or add it later with ADDLOCAL=ContextMenu and the same
               INSTALLFOLDER. An upgrade from a version that always added it keeps it. The program
               is named through its folder: a feature may not refer to a file of another one. -->
          <Component Id="ContextMenu" Guid="*" Win64="yes">
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\winc" Value="Open in Winc" Type="string" KeyPath="yes"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\winc" Name="Icon" Value="[INSTALLFOLDER]winc.exe,0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\shell\winc\command" Value="&quot;[INSTALLFOLDER]winc.exe&quot; &quot;%V&quot;" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\winc" Value="Open in Winc" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\winc" Name="Icon" Value="[INSTALLFOLDER]winc.exe,0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\Directory\Background\shell\winc\command" Value="&quot;[INSTALLFOLDER]winc.exe&quot; &quot;%V&quot;" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\*\shell\winc" Value="Open with Winc" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\*\shell\winc" Name="Icon" Value="[INSTALLFOLDER]winc.exe,0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\*\shell\winc\command" Value="&quot;[INSTALLFOLDER]winc.exe&quot; &quot;%1&quot;" Type="string"/>
          </Component>
          <!-- The winc: URL scheme: winc://file/<absolute path>[:line[:column]] opens a file or
               folder in winc, which receives the whole link as its argument. The shell checks only
               that "URL Protocol" exists; an empty value means Null to Windows Installer, so it
               holds a placeholder. -->
          <Component Id="UrlScheme" Guid="*" Win64="yes">
            <RegistryValue Root="HKLM" Key="Software\Classes\winc" Value="URL:Winc" Type="string" KeyPath="yes"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc" Name="URL Protocol" Value="winc" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc\DefaultIcon" Value="[#WincExe],0" Type="string"/>
            <RegistryValue Root="HKLM" Key="Software\Classes\winc\shell\open\command" Value="&quot;[#WincExe]&quot; &quot;%1&quot;" Type="string"/>
          </Component>
          <Directory Id="BINFOLDER" Name="bin">
            <Component Id="CommandLine" Guid="*" Win64="yes">
              <File Id="WincLauncher" Source="$(var.Source)\bin\winc" KeyPath="yes"/>
              <Environment Id="WincPath" Name="PATH" Value="[BINFOLDER]" Action="set" Part="last" System="yes" Permanent="no"/>
            </Component>
            <Component Id="CommandLineCmd" Guid="*" Win64="yes">
              <File Id="WincLauncherCmd" Source="$(var.Source)\bin\winc.cmd" KeyPath="yes"/>
            </Component>
          </Directory>
          <Component Id="License" Guid="*" Win64="yes"><File Source="$(var.Source)\LICENSE" KeyPath="yes"/></Component>
          <Component Id="Notice" Guid="*" Win64="yes"><File Source="$(var.Source)\NOTICE" KeyPath="yes"/></Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Winc">
          <Component Id="StartMenu" Guid="*" Win64="yes">
            <Shortcut Id="StartMenuShortcut" Name="Winc" Target="[#WincExe]" WorkingDirectory="INSTALLFOLDER" Icon="WincIcon"/>
            <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\DEEIX\winc\MSI" Name="Start Menu Shortcut" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="Main" Title="winc" Level="1">
      <ComponentRef Id="Application"/><ComponentRef Id="TerminalHelper"/><ComponentRef Id="InstallationKind"/>
      <ComponentRef Id="ConptyLibrary"/><ComponentRef Id="ConsoleHost"/>
      <ComponentRef Id="FileAssociations"/><ComponentRef Id="UrlScheme"/>
      <ComponentRef Id="CommandLine"/><ComponentRef Id="CommandLineCmd"/><ComponentRef Id="WslWatcher"/>
      <ComponentRef Id="RemoteServerX64"/><ComponentRef Id="RemoteServerArm64"/>
      <ComponentRef Id="License"/><ComponentRef Id="Notice"/><ComponentRef Id="StartMenu"/>
      <ComponentRef Id="Icon_markdown"/><ComponentRef Id="Icon_json"/><ComponentRef Id="Icon_config"/><ComponentRef Id="Icon_markup"/><ComponentRef Id="Icon_style"/><ComponentRef Id="Icon_script"/><ComponentRef Id="Icon_table"/><ComponentRef Id="Icon_text"/><ComponentRef Id="Icon_javascript"/><ComponentRef Id="Icon_typescript"/><ComponentRef Id="Icon_python"/><ComponentRef Id="Icon_rust"/><ComponentRef Id="Icon_go"/><ComponentRef Id="Icon_c"/><ComponentRef Id="Icon_code"/><ComponentRef Id="Icon_file"/>
    </Feature>
    <Feature Id="ContextMenu" Title="Explorer context menu" Level="1000">
      <Condition Level="1">WIX_UPGRADE_DETECTED</Condition>
      <ComponentRef Id="ContextMenu"/>
    </Feature>
    <Feature Id="FileTypes" Title="Associate file types" Level="1">
      <ComponentRef Id="FileTypeListing"/>
    </Feature>
    <!-- Register text file types after the executable is on disk; remove them before it is deleted. -->
    <!-- Deferred and impersonated so per-machine setup still writes the installing user's HKCU. -->
    <CustomAction Id="RegisterFileTypes" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]winc.exe&quot; --register-file-types"
                  Execute="deferred" Impersonate="yes" Return="ignore"/>
    <CustomAction Id="UnregisterFileTypes" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]winc.exe&quot; --unregister-file-types"
                  Execute="deferred" Impersonate="yes" Return="ignore"/>
    <InstallExecuteSequence>
      <Custom Action="RegisterFileTypes" After="InstallFiles">NOT REMOVE</Custom>
      <Custom Action="UnregisterFileTypes" Before="RemoveFiles">REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
